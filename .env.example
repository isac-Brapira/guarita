# Copie este arquivo para .env e preencha com seus valores reais.
# O .env NÃO deve ser commitado no Git (já está no .gitignore).

# === Plate Recognizer ===
PLATE_RECOGNIZER_TOKEN=cole_seu_token_aqui
PLATE_RECOGNIZER_REGION=br

# === Fonte de vídeo ===
# Opções:
#   - Webcam local:  0  (ou 1, 2...)
#   - Arquivo:       /caminho/do/video.mp4
#   - RTSP do DVR:   rtsp://usuario:senha@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0
VIDEO_SOURCE=0
